# ElevenLabs — cần cho TTS_PROVIDER=elevenlabs (mặc định) và setup-sfx/music-library.mjs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=3VnrjnYrskPMDsapTr8X

# TTS provider cho scripts/generate-audio.mjs — elevenlabs (mặc định) | edge-tts (free, không cần key)
TTS_PROVIDER=elevenlabs
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural

# DashScope — cần cho toàn bộ agent trong server/ (content-planner, video-planner,
# scene-writer, root-composer)
DASHSCOPE_API_KEY=
# Model cho content-planner + video-planner (chạy 1 lần/video, cần chất lượng cao)
DASHSCOPE_MODEL=qwen-plus
# Model cho scene-writer + root-composer (chạy nhiều lần/video — mỗi scene 1 lần —
# việc chủ yếu là bám theo skill/convention có sẵn, không cần model đắt)
DASHSCOPE_MODEL_CHEAP=qwen-turbo
