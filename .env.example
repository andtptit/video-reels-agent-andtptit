# ElevenLabs — cần cho TTS_PROVIDER=elevenlabs (mặc định) và setup-sfx/music-library.mjs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=3VnrjnYrskPMDsapTr8X

# TTS provider cho scripts/generate-audio.mjs — elevenlabs | edge-tts (free, không cần
# key). Mặc định edge-tts vì ElevenLabs Free plan chặn cả TTS-qua-API lẫn Sound
# Generation (xem plan.md, Phase 0) — chỉ đổi lại "elevenlabs" nếu đã nâng cấp gói.
TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural

# DashScope — cần cho toàn bộ agent trong server/ (content-planner, video-planner,
# scene-writer, root-composer)
DASHSCOPE_API_KEY=
# Model cho content-planner + video-planner (chạy 1 lần/video, cần chất lượng cao).
# UI cũng cho chọn model này riêng mỗi lần chạy (ghi đè giá trị .env) — đây chỉ là
# mặc định khi UI không chọn. Đã xác nhận thật (tool_calls hoạt động đúng):
# qwen3.5-plus | qwen-plus-2025-04-28 | qwen3.6-plus (giá trị hiện tại)
# KHÔNG dùng qwen-vl-ocr — cần ảnh đầu vào, không phải model chat.
DASHSCOPE_MODEL=qwen3.6-plus
# Model cho scene-writer + root-composer (chạy nhiều lần/video — mỗi scene 1 lần —
# việc chủ yếu là bám theo skill/convention có sẵn, không cần model đắt). UI cũng
# chọn được, giá trị này chỉ là mặc định. Đã xác nhận thật:
# qwen3.6-flash | qwen-flash | deepseek-v4-flash | qwen3-vl-flash | qwen3.7-flash (hiện tại)
# KHÔNG dùng qwen-mt-flash — không hỗ trợ tool_calls (chỉ dịch thuật).
DASHSCOPE_MODEL_CHEAP=qwen3.7-flash
# Model sinh ảnh nền AI — dùng khi chọn visualStyle="ai-image" hoặc template="sub".
# UI cũng chọn được. Mỗi model family có size hợp lệ riêng (xem SIZE_TABLES trong
# dashscope-image.mjs) — đã xác nhận thật cả 4:
# wan2.6-image (hiện tại) | qwen-image | qwen-image-2.0 | z-image-turbo
# KHÔNG dùng wan2.1-kf2v-plus/wan2.7-i2v/wan2.6-t2v — đây là model SINH VIDEO
# (keyframe-to-video/image-to-video/text-to-video), cần endpoint + luồng khác hẳn,
# không tương thích code sinh ảnh tĩnh hiện tại (test thật: lỗi "url error").
DASHSCOPE_MODEL_IMAGE=wan2.6-image
