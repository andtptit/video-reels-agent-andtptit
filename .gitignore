# Secrets
.env
server/profiles/secrets/

# Dependencies
node_modules/

# Binary media — không commit MP4/MP3, TRỪ nhạc nền/SFX dùng chung của workspace
# (nhỏ, cố định, cần có sẵn để render chạy được ngay sau khi clone).
*.mp4
*.mp3
!assets/music/**
!assets/sfx/**

# HyperFrames cache
.hyperframes/
.thumbnails/
.waveform-cache/

# macOS Finder metadata
.DS_Store

# Phase 2 runtime job progress — ephemeral, regenerated per pipeline run
job-status.json

# Image-model fallback runtime state (which model the chain is currently on) —
# ephemeral, see lib/image-model-fallback.mjs. server/config/ (the ordered chain
# itself) IS committed — only this mutable pointer file is excluded.
server/state/

# Generated video projects — output/ holds real render artifacts (images, HTML,
# hundreds of MB per project), not source. Only *.mp4/*.mp3 were excluded before,
# leaving PNG/HTML/JSON untracked-but-visible; excluding the whole tree instead.
output/

# Exported "gọn" copies of rendered videos (History tab's "Xuất gọn"/"Xuất tất cả") —
# same generated-artifact reasoning as output/ above, just a different destination.
output-ready/

# "Hàng loạt" (Batch) scratch working dirs — see routes.mjs's withBatchDir doc
# comment: only ever holds ideas.json + job-status.json for an in-progress batch
# review, never a real project. Ephemeral, not source.
server/batches/

# macOS AppleDouble sidecar files — this workspace runs on an external volume
# without native xattr support, so every file write leaves a "._filename" twin.
# hyperframes lint has been observed scanning these as bogus composition files.
._*

# Footage/image library — push CHỈ cấu trúc thư mục (giữ qua .gitkeep), KHÔNG push
# ảnh/clip thật bên trong: nội dung do người dùng tự thêm/AI tự sinh liên tục theo
# từng profile, không phải nguồn cố định của workspace, và có thể chứa ảnh nhạy cảm
# không nên để công khai trên repo. manifest.json (cache thời lượng/tag) cũng loại
# theo, vì nó vô nghĩa khi không có file thật đi kèm.
assets/footage-library/*
!assets/footage-library/.gitkeep
assets/image-library/*
!assets/image-library/.gitkeep
